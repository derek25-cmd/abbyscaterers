# Same Supabase project as apps/catering-system. HR managers sign in with
# their existing catering-system accounts; kiosk tablets have their own
# device logins (never staff_users rows).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Not used yet: later phases use it to create kiosk device
# logins. Never prefix it with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Digital Asset Links for the Android (Trusted Web Activity) build, served
# at /.well-known/assetlinks.json. A JSON array, on one line, e.g.
# [{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"tz.co.abbys.attendance","sha256_cert_fingerprints":["AA:BB:..."]}}]
# Leave empty to serve [] until the APK is signed.
ANDROID_ASSETLINKS_JSON=
