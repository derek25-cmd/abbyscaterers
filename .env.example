# Copy this file to .env and fill in real values. Never commit .env itself
# (it's gitignored) — this file exists so a new environment/dev knows what's
# required without guessing.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose this to the browser. Used by API routes/scripts
# that need to bypass RLS (e.g. scripts/invite-staff.js).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI features (required for AI-assisted features; routes degrade
# gracefully with a 503 if unset, see e.g. src/app/api/marketing/ai/*) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Mapbox (required for the live marketing map page) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Cron (required — protects /api/cron/* from unauthenticated triggers) ---
CRON_SECRET=

# --- Rate limiting (optional — inert/no-op until both are set, see
# src/lib/rate-limit.ts. Get free-tier credentials at upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error tracking (optional — inert until set, see instrumentation-client.ts /
# sentry.server.config.ts / sentry.edge.config.ts) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed for source-map upload during build (next.config.js) — build
# succeeds without these, just with unminified stack traces in Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
